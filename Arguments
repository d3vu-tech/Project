##anonymous function

lst=[1,2,3,4,5,6,7,8]
sqr=list(map(lambda x:x*x,lst))
print(sqr)

lst=[1,2,3,4,5,6,7,8]
sqr=list(filter(lambda x:x*x,lst))
print(sqr)

lst=[1,2,3,4,5,6,7,8]
sqr=list(filter(lambda x:x%2==0,lst))
print(sqr)

